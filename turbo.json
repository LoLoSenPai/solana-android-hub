{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ADMIN_WALLETS",
        "ALLOWED_PREVIEW_APP_MINTS",
        "APP_ENV",
        "CONSENT_TERMS_VERSION",
        "CRON_SECRET",
        "DATABASE_URL",
        "EXPO_PUBLIC_HUB_ORIGIN",
        "GITHUB_DISPATCH_TOKEN",
        "GITHUB_OIDC_AUDIENCE",
        "GITHUB_REPOSITORY",
        "GITHUB_VALIDATOR_REF",
        "HELIUS_API_KEY",
        "HUB_ANDROID_APK_CERTIFICATE_SHA256",
        "HUB_ANDROID_APK_MANDATORY",
        "HUB_ANDROID_APK_PERMISSIONS_JSON",
        "HUB_ANDROID_APK_PUBLISHED_AT",
        "HUB_ANDROID_APK_RELEASE_NOTES_JSON",
        "HUB_ANDROID_APK_SIZE",
        "HUB_ORIGIN",
        "NEXT_PUBLIC_HUB_ANDROID_APK_SHA256",
        "NEXT_PUBLIC_HUB_ANDROID_APK_URL",
        "NEXT_PUBLIC_HUB_ANDROID_APK_VERSION",
        "NEXT_PUBLIC_HUB_ANDROID_APK_VERSION_CODE",
        "RELEASE_PUBLICATION_GATE",
        "SESSION_PEPPER",
        "SOLANA_NETWORK"
      ],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_TEST_URL"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
